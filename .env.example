# ============================================================
#  Variables de entorno (copiar a ".env" y ajustar)
# ============================================================

# --- Aplicación ---
APP_NAME="Franciosi Odontología API"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# --- Base de datos ---
# SQLite (entorno local / desarrollo)
DATABASE_URL="sqlite:///./odontologico.db"
# PostgreSQL (descomentar y ajustar credenciales)
# DATABASE_URL="postgresql+psycopg://usuario:password@localhost:5432/odontologico"

# --- CORS (interfaz web y clientes externos) ---
# Orígenes autorizados a consumir la API desde otro dominio ("*" = cualquiera).
# Para restringir, usar una lista JSON: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["*"]
# Habilita el envío de cookies/credenciales (el navegador exige orígenes
# explícitos, no "*").
CORS_ALLOW_CREDENTIALS=false

# --- WhatsApp Cloud API (opcional) ---
# Si falta el token o el id del número, los recordatorios y las respuestas del
# FAQ Bot se SIMULAN (no se realizan peticiones reales a Meta).
# El token se acepta con los dos nombres de la documentación de Meta:
#   WHATSAPP_TOKEN          (corto, el que usa la doc de la Cloud API)
#   WHATSAPP_ACCESS_TOKEN   (el histórico del proyecto)
# Si los dos están definidos gana WHATSAPP_ACCESS_TOKEN. Un valor vacío ("") se
# interpreta como "sin configurar".
# La URL de la API es opcional: por defecto, https://graph.facebook.com/v21.0
WHATSAPP_API_URL=""
# "Phone Number ID" que muestra Meta en WhatsApp -> API Setup (ID numérico).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# Secreto elegido al configurar el webhook en Meta (Webhook -> Verify token).
# NO es el access token: es el valor que Meta reenvía como hub.verify_token.
WHATSAPP_VERIFY_TOKEN=""

# --- Chatbot de respuestas automáticas (FAQ Bot) ---
# Código del nomenclador con el que el bot responde la tarifa de la consulta
# (Capítulo I: consulta, examen y fichado - Nomenclador de Córdoba).
WHATSAPP_CONSULTA_CODIGO="10100"
# Datos que devuelve la opción 3 del menú (Ubicación y horarios).
WHATSAPP_CONSULTORIO_DIRECCION="Av. Colón 1234, Córdoba Capital"
WHATSAPP_CONSULTORIO_HORARIOS="Lunes a viernes de 9:00 a 13:00 y de 15:00 a 19:00"

# --- Recordatorios ---
# Antelación (en días) con la que se envían los recordatorios y ventana que
# muestra la pestaña "Recordatorios Pendientes" del panel.
RECORDATORIO_DIAS=3
# Código de país (con el "9" de móvil) que se antepone a los teléfonos locales
# al generar los enlaces Click-to-Chat de WhatsApp. Argentina móvil: 549.
WHATSAPP_CODIGO_PAIS="549"

# --- Ficha pública de salud (Módulo 4: anamnesis) ---
# URL absoluta del sitio que se usa en el enlace enviado al paciente.
# Si se deja vacía, en Vercel se deduce del dominio del despliegue y en local
# se usa http://localhost:8000.
PUBLIC_BASE_URL=""
# Secreto con el que se firman los tokens HMAC de /anamnesis/{token}. Debe ser
# largo y aleatorio. Si se deja vacío se reutiliza WHATSAPP_VERIFY_TOKEN o una
# clave derivada de la configuración del servidor.
ANAMNESIS_TOKEN_SECRET=""
# El botón "Enviar ficha" del panel y `python -m scripts.enviar_ficha --api`
# usan las mismas credenciales de WhatsApp que los recordatorios. Sin
# WHATSAPP_TOKEN/WHATSAPP_ACCESS_TOKEN y WHATSAPP_PHONE_NUMBER_ID el envío queda
# simulado (no sale ningún mensaje) y el panel lo avisa.
