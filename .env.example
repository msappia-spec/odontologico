# ============================================================
#  Variables de entorno (copiar a ".env" y ajustar)
# ============================================================

# --- Aplicación ---
APP_NAME="Franciosi Odontología API"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# --- Base de datos ---
# SQLite (entorno local / desarrollo)
DATABASE_URL="sqlite:///./odontologico.db"
# PostgreSQL (descomentar y ajustar credenciales)
# DATABASE_URL="postgresql+psycopg://usuario:password@localhost:5432/odontologico"

# --- CORS (interfaz web y clientes externos) ---
# Orígenes autorizados a consumir la API desde otro dominio ("*" = cualquiera).
# Para restringir, usar una lista JSON: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["*"]
# Habilita el envío de cookies/credenciales (el navegador exige orígenes
# explícitos, no "*").
CORS_ALLOW_CREDENTIALS=false

# --- Autenticación del panel (Módulo de usuarios y permisos) ---
# Clave con la que se firman los JWT de sesión (HS256). Debe ser larga y
# aleatoria: `python -m scripts.crear_admin` la genera y la agrega a este archivo
# si falta. Sin SECRET_KEY la app deriva una clave de la configuración (sirve en
# desarrollo, pero en producción hay que definirla).
SECRET_KEY=""
# Horas de vigencia de la sesión (cookie HttpOnly + token Bearer).
ACCESS_TOKEN_EXPIRE_HOURS=8
# Fuerza bruta: intentos fallidos permitidos por IP y ventana en segundos.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=60

# --- WebAuthn / passkeys (huella digital y Face ID) ---
# Dominio con el que el navegador vincula las huellas (SIN esquema ni puerto):
#   local:      "localhost"
#   producción: "mi-panel.vercel.app" (o el dominio propio del consultorio)
# Origen exacto que valida la firma (CON esquema y puerto si no es 443):
#   local:      "http://localhost:8000"
#   producción: "https://mi-panel.vercel.app"
# Si se dejan vacíos, se deducen de PUBLIC_BASE_URL (o del dominio de Vercel).
# Importante: si cambia el dominio, las huellas registradas dejan de valer.
RP_ID=""
RP_ORIGIN=""
RP_NAME="Franciosi Odontología"
# Minutos de validez del desafío firmado y espera máxima del lector (ms).
WEBAUTHN_CHALLENGE_EXPIRE_MINUTES=2
WEBAUTHN_TIMEOUT_MS=60000

# --- WAHA (WhatsApp HTTP API) ---
# Si falta WAHA_API_KEY, los recordatorios y las respuestas del FAQ Bot se
# SIMULAN (no se realizan peticiones reales).
# URL base de WAHA, sin "/api". Ejemplos:
#   http://localhost:3000          (WAHA en la misma máquina)
#   http://turnos_waha:3000        (Docker, red interna del contenedor)
#   https://<host>.nip.io          (WAHA publicado en otra máquina/Vercel)
WAHA_URL="http://localhost:3000"
# Valor configurado en WAHA y enviado en la cabecera X-Api-Key.
WAHA_API_KEY=""
# Sesión de WAHA que envía y recibe los mensajes.
WAHA_SESSION="default"
# El webhook a configurar en WAHA es:
#   {PUBLIC_BASE_URL}/api/v1/whatsapp/webhook

# --- Chatbot de respuestas automáticas (FAQ Bot) ---
# Código del nomenclador con el que el bot responde la tarifa de la consulta
# (Capítulo I: consulta, examen y fichado - Nomenclador de Córdoba).
WHATSAPP_CONSULTA_CODIGO="10100"
# Datos que devuelve la opción 3 del menú (Ubicación y horarios).
WHATSAPP_CONSULTORIO_DIRECCION="Av. Colón 1234, Córdoba Capital"
WHATSAPP_CONSULTORIO_HORARIOS="Lunes a viernes de 9:00 a 13:00 y de 15:00 a 19:00"

# --- Recordatorios ---
# Antelación (en días) con la que se envían los recordatorios y ventana que
# muestra la pestaña "Recordatorios Pendientes" del panel.
RECORDATORIO_DIAS=3
# Código de país (con el "9" de móvil) que se antepone a los teléfonos locales
# al generar los enlaces Click-to-Chat de WhatsApp. Argentina móvil: 549.
WHATSAPP_CODIGO_PAIS="549"

# Secreto largo y aleatorio. Vercel lo envía como Bearer al cron diario y el
# endpoint rechaza cualquier ejecución sin este valor.
CRON_SECRET=""

# --- Ficha pública de salud (Módulo 4: anamnesis) ---
# URL absoluta del sitio que se usa en el enlace enviado al paciente.
# Si se deja vacía, en Vercel se deduce del dominio del despliegue y en local
# se usa http://localhost:8000.
PUBLIC_BASE_URL=""
# Secreto con el que se firman los tokens HMAC de /anamnesis/{token}. Debe ser
# largo y aleatorio. Si se deja vacío se usa una clave derivada de la
# configuración del servidor.
ANAMNESIS_TOKEN_SECRET=""
# El botón "Enviar ficha" del panel y `python -m scripts.enviar_ficha --api`
# usan las mismas credenciales de WAHA que los recordatorios. Sin WAHA_URL y
# WAHA_API_KEY el envío queda simulado (no sale ningún mensaje) y el panel lo
# avisa.
