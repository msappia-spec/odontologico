# ============================================================
#  Archivos que NO se suben en un deploy con la CLI de Vercel
#  (equivalente a .gitignore; se evita empaquetar el entorno
#  virtual, la base local y los artefactos de pruebas).
# ============================================================

.venv/
venv/
env/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.cache/
.coverage
htmlcov/

# Base de datos local y sus respaldos
*.db
*.sqlite3
*.db.bak-*

# Logs
*.log

# Pruebas y scripts auxiliares (no se usan en runtime)
tests/
scripts/

# Atajos de publicación (se usan desde la máquina, no dentro del deploy)
publicar.bat

# Editores
.vscode/
.idea/
*.swp

# Configuración local del propio CLI
.vercel/

# Secretos locales: en Vercel se cargan como Environment Variables,
# no se empaquetan en el deploy.
.env
.env.local
.env.*.local
